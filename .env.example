# Docker binds to localhost by default. See docs/DEPLOYMENT.md before public exposure.
BIND_ADDRESS=127.0.0.1
PORT=8080
YTD_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
YTD_SECURE_COOKIES=false

# Native development only. Compose stores data in its /data volume.
YTD_DATA_DIR=.data
# YTD_FFMPEG_LOCATION=/absolute/path/to/ffmpeg/bin
YTD_JS_RUNTIME=node

YTD_MAX_ACTIVE_PER_SESSION=2
YTD_MAX_QUEUE=12
YTD_RATE_LIMIT=5
YTD_RATE_WINDOW_SECONDS=600
YTD_MAX_DURATION_SECONDS=7200
YTD_MAX_FILE_BYTES=524288000
YTD_MAX_JOB_BYTES=1073741824
YTD_MAX_STORAGE_BYTES=5368709120
YTD_JOB_TIMEOUT_SECONDS=1800
YTD_RETENTION_SECONDS=3600
