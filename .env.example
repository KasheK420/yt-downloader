# Docker binds to localhost by default. See docs/DEPLOYMENT.md before public exposure.
BIND_ADDRESS=127.0.0.1
PORT=8080
YTD_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
YTD_SECURE_COOKIES=false

# Public mode enables guest/free-account budgets. Private defaults remain unchanged.
YTD_PUBLIC_MODE=false
YTD_REQUIRE_LOGIN=false
# Optional sign-in: see docs/AUTHENTICATION.md. Keep real credentials in ignored .env only.
# YTD_PUBLIC_ORIGIN=https://downloads.example.com
# YTD_GOOGLE_CLIENT_ID=replace-with-web-client-id
# YTD_GOOGLE_CLIENT_SECRET=replace-with-client-secret
# YTD_FACEBOOK_CLIENT_ID=replace-with-app-id
# YTD_FACEBOOK_CLIENT_SECRET=replace-with-app-secret
YTD_FACEBOOK_API_VERSION=v26.0
YTD_GUEST_DOWNLOADS=3
YTD_GUEST_WINDOW_SECONDS=3600
YTD_FREE_DOWNLOADS=20
YTD_FREE_WINDOW_SECONDS=86400
YTD_GUEST_MAX_DURATION_SECONDS=1800
YTD_GUEST_MAX_FILE_BYTES=262144000
YTD_GUEST_MAX_QUALITY=720
YTD_PUBLIC_IP_DAILY_LIMIT=40

# Native development only. Compose stores data in its /data volume.
YTD_DATA_DIR=.data
# YTD_FFMPEG_LOCATION=/absolute/path/to/ffmpeg/bin
YTD_JS_RUNTIME=node

YTD_MAX_ACTIVE_PER_SESSION=2
YTD_MAX_QUEUE=12
YTD_MAX_QUEUE_WAIT_SECONDS=1800
YTD_RATE_LIMIT=5
YTD_RATE_WINDOW_SECONDS=600
YTD_MAX_DURATION_SECONDS=7200
YTD_MAX_FILE_BYTES=524288000
YTD_MAX_JOB_BYTES=1073741824
YTD_MAX_STORAGE_BYTES=5368709120
YTD_JOB_TIMEOUT_SECONDS=1800
YTD_RETENTION_SECONDS=3600
YTD_CLEANUP_INTERVAL_SECONDS=15
